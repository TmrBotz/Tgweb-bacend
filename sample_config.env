# ---------------------------------------------------------------------
# COLLECTIONS
# Every file is put in the collection(s) whose keywords match its title.
#
#   name: keyword1, keyword2 | other name: keyword
#
#  - rules are separated by  |
#  - name = text before the first ':'   (spaces allowed, e.g. "new latest")
#  - keywords are separated by ','  and are OR-ed
#  - a keyword matches only when the WHOLE phrase is in the title
#    (case-insensitive; '.', '-' and '_' count as spaces)
#  - start a keyword with  re:  to use a regex  (e.g.  re:S\d+E\d+ )
#  - one title can land in several collections
#  - use SINGLE quotes so backslashes in regex are kept as written
# ---------------------------------------------------------------------
COLLECTIONS = 'movie: Jawan 2024, Pathaan 2023 | new latest: 2026 | tv: re:S\d+E\d+, season'

# Title matched no collection -> goes here
DEFAULT_COLLECTION = "new videos"
